{
  "name": "cyore",
  "displayName": "CYORE — VS Code Extension in Rust",
  "description": "A VS Code extension written in Rust — the extension is converted to Rust.",
  "version": "0.0.1",
  "icon": "icon.png",
  "publisher": "dinguk062499999",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dinguk0624/CYORE.git"
  },
  "bugs": {
    "url": "https://github.com/dinguk0624/CYORE/issues"
  },
  "keywords": ["extension", "strings", "extractor", "vscode"],
  "activationEvents": ["onCommand:cyore.extractStrings"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cyore.extractStrings",
        "title": "CYORE: Extract Strings"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CYORE",
      "properties": {
        "cyore.minStringLength": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Minimum length of strings to extract."
        }
      }
    }
  }
}
